APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Local/testing-only seeded account support. Never enable this in pilot, staging, or production.
RIKMS_ALLOW_DEV_SEED_ACCOUNTS=false
RIKMS_DEV_SUPER_ADMIN_AUTH_CODE=123456

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Required for pilot/staging/production. Use comma-separated exact hostnames and proxy IP/CIDR values.
TRUSTED_HOSTS=
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host

DB_CONNECTION=sqlite
# SQLite is the local pilot database. Keep MySQL settings available for production readiness.
# DB_DATABASE=/absolute/path/to/database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rikms
# DB_USERNAME=root
# DB_PASSWORD=

# MongoDB is secondary storage for AI/PDF/flexible metadata only.
# Use your MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=
MONGODB_DATABASE=rikms_ai

# Put real API credentials only in .env or your deployment secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_METADATA_MAX_CHARS=20000
AI_PDF_MAX_TEXT_CHARS=200000

# Production requirement: set MALWARE_SCANNER=clamav and point CLAMAV_HOST/PORT to a tested private service.
# "none" is permitted only for local development. Tests explicitly use the fake scanner from phpunit.xml.
MALWARE_SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
UPLOAD_QUARANTINE_DISK=local
UPLOAD_STORAGE_DISK=local

PUBLIC_ACCESS_REQUESTS_ENABLED=true
PUBLIC_ACCESS_REQUEST_LIMIT_PER_MINUTE=5
PUBLIC_ACCESS_REQUEST_LIMIT_PER_HOUR=20
PUBLIC_ACCESS_REQUEST_EMAIL_LIMIT_PER_HOUR=3
PUBLIC_API_LIMIT_PER_MINUTE=60
PUBLIC_DOWNLOAD_LIMIT_PER_MINUTE=20
APPROVED_ACCESS_LIMIT_PER_MINUTE=10
PUBLIC_CACHE_LIST_TTL_SECONDS=60
PUBLIC_CACHE_SUMMARY_TTL_SECONDS=300
PUBLIC_CACHE_AGENCY_TTL_SECONDS=300
PUBLIC_ACCESS_REQUEST_MIN_FORM_SECONDS=2
PUBLIC_ACCESS_REQUEST_FORM_TOKEN_TTL_MINUTES=120
PUBLIC_ACCESS_REQUEST_CAPTCHA_ENABLED=true
VITE_PUBLIC_ACCESS_REQUEST_CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_TIMEOUT_SECONDS=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
RIKMS_FORCE_SUPER_ADMIN_MFA=true

# CSP_MODE: off for local/testing, report-only for pilot/staging, enforce for production.
# Set CSP_PRODUCTION_VALIDATED=true only after reviewing staging reports and resolving required violations.
CSP_MODE=off
CSP_REPORT_URI=
CSP_PRODUCTION_VALIDATED=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Agency notification digests. Day values follow Laravel: Monday=1 for weekly;
# monthly day must be between 1 and 28.
SCHEDULED_AGENCY_EMAILS_ENABLED=true
SCHEDULED_AGENCY_EMAILS_TIMEZONE=Asia/Manila
WEEKLY_DIGEST_DAY=1
WEEKLY_DIGEST_TIME=08:00
MONTHLY_ANALYTICS_DAY=1
MONTHLY_ANALYTICS_TIME=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
