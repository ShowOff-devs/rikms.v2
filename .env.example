APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Local/testing-only seeded account support. Never enable this in pilot, staging, or production.
RIKMS_ALLOW_DEV_SEED_ACCOUNTS=false
RIKMS_DEV_SUPER_ADMIN_AUTH_CODE=123456

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# Independent operational alerts. Use a monitored institutional mailbox and/or HTTPS webhook.
MONITORING_ALERTS_ENABLED=false
MONITORING_ALERT_EMAILS=
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_TIMEOUT_SECONDS=5
MONITORING_ALERT_COOLDOWN_MINUTES=30
MONITORING_SEND_RECOVERY_ALERTS=true
MONITORING_REQUIRE_BACKUP_READY=false
MONITORING_PENDING_JOBS_WARNING=100
MONITORING_PENDING_JOBS_CRITICAL=500
MONITORING_OLDEST_JOB_WARNING_MINUTES=5
MONITORING_OLDEST_JOB_CRITICAL_MINUTES=60
MONITORING_FAILED_JOBS_CRITICAL=5
MONITORING_DISK_WARNING_PERCENT=80
MONITORING_DISK_CRITICAL_PERCENT=90
MONITORING_SECURITY_LOOKBACK_MINUTES=15
MONITORING_QUEUES=health,default

# Required for pilot/staging/production. Use comma-separated exact hostnames and proxy IP/CIDR values.
TRUSTED_HOSTS=
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host

DB_CONNECTION=sqlite
# SQLite is the local pilot database. Keep MySQL settings available for production readiness.
# DB_DATABASE=/absolute/path/to/database/database.sqlite
# DB_SQLITE_BUSY_TIMEOUT=5000
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rikms
# DB_USERNAME=root
# DB_PASSWORD=

# MongoDB is secondary storage for AI/PDF/flexible metadata only.
# Use your MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=
MONGODB_DATABASE=rikms_ai
INFRA_REQUIRE_MONGODB=false

# Put real API credentials only in .env or your deployment secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_METADATA_MAX_CHARS=20000
AI_PDF_MAX_TEXT_CHARS=200000

# Production requirement: set MALWARE_SCANNER=clamav and point CLAMAV_HOST/PORT to a tested private service.
# "none" is permitted only for local development. Tests explicitly use the fake scanner from phpunit.xml.
MALWARE_SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
# Must match clamd StreamMaxLength and cover the application's effective maximum upload size.
CLAMAV_STREAM_MAX_LENGTH_MB=100
# Separate local disks outside the public web root. Do not use the public disk for research PDFs.
UPLOAD_QUARANTINE_DISK=upload_quarantine
UPLOAD_STORAGE_DISK=private_uploads
UPLOAD_AGENCY_QUOTA_MB=10240
# Keep automated/destructive reconciliation disabled until its dry-run output is reviewed.
STORAGE_RECONCILIATION_REPAIR_ENABLED=false
INFRA_REQUIRE_REMOTE_STORAGE=false
INFRA_HEALTHCHECK_PREFIX=.rikms-health

PUBLIC_ACCESS_REQUESTS_ENABLED=true
PUBLIC_ACCESS_REQUEST_LIMIT_PER_MINUTE=5
PUBLIC_ACCESS_REQUEST_LIMIT_PER_HOUR=20
PUBLIC_ACCESS_REQUEST_EMAIL_LIMIT_PER_HOUR=3
PUBLIC_API_LIMIT_PER_MINUTE=60
PUBLIC_DOWNLOAD_LIMIT_PER_MINUTE=20
APPROVED_ACCESS_LIMIT_PER_MINUTE=10
PUBLIC_CACHE_LIST_TTL_SECONDS=60
PUBLIC_CACHE_SUMMARY_TTL_SECONDS=300
PUBLIC_CACHE_AGENCY_TTL_SECONDS=300
PUBLIC_ACCESS_REQUEST_MIN_FORM_SECONDS=2
PUBLIC_ACCESS_REQUEST_FORM_TOKEN_TTL_MINUTES=120
PUBLIC_ACCESS_REQUEST_CAPTCHA_ENABLED=true
VITE_PUBLIC_ACCESS_REQUEST_CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_TIMEOUT_SECONDS=3
# Comma-separated exact frontend hostnames only; do not include schemes, ports, paths, or wildcards.
CAPTCHA_ALLOWED_HOSTNAMES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
RIKMS_FORCE_SUPER_ADMIN_MFA=true

# CSP_MODE: off for local/testing, report-only for pilot/staging, enforce for production.
# Set CSP_PRODUCTION_VALIDATED=true only after reviewing staging reports and resolving required violations.
CSP_MODE=off
CSP_REPORT_URI=/api/security/csp-reports
CSP_REPORT_COLLECTOR_ENABLED=true
CSP_REPORT_MAX_PAYLOAD_BYTES=65536
CSP_REPORT_MAX_REPORTS_PER_REQUEST=20
CSP_REPORT_LIMIT_PER_MINUTE=120
CSP_REPORT_RETENTION_DAYS=30
CSP_PRODUCTION_VALIDATED=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_FAILED_DRIVER=database-uuids
RUNTIME_HEARTBEAT_STALE_AFTER_SECONDS=300

# External backup preparation. Keep execution disabled until backup and restore tests pass.
# Windows example: E:/RIKMS-Backups; Ubuntu example: /mnt/rikms-backup
BACKUP_EXECUTION_ENABLED=false
BACKUP_DESTINATION_PATH=
# Use a dedicated random value of at least 32 characters; never use a BitLocker/LUKS recovery key here.
BACKUP_ENCRYPTION_KEY=
BACKUP_MINIMUM_FREE_SPACE_MB=10240
BACKUP_REQUIRE_SEPARATE_FILESYSTEM=true
INFRA_REQUIRE_BACKUP_READY=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Agency notification digests. Day values follow Laravel: Monday=1 for weekly;
# monthly day must be between 1 and 28.
SCHEDULED_AGENCY_EMAILS_ENABLED=true
SCHEDULED_AGENCY_EMAILS_TIMEZONE=Asia/Manila
WEEKLY_DIGEST_DAY=1
WEEKLY_DIGEST_TIME=08:00
MONTHLY_ANALYTICS_DAY=1
MONTHLY_ANALYTICS_TIME=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_PRIVATE_ROOT=private
AWS_QUARANTINE_BUCKET=
AWS_QUARANTINE_ROOT=quarantine
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SERVER_SIDE_ENCRYPTION=AES256
# When using a KMS key, set AWS_SERVER_SIDE_ENCRYPTION=aws:kms.
AWS_KMS_KEY_ID=

VITE_APP_NAME="${APP_NAME}"
