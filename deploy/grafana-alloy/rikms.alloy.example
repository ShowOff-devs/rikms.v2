// Replace the environment values with the connection details generated by your Grafana Cloud stack.
// Keep the access-policy token outside this file, for example in Alloy's protected environment file.

loki.source.journal "rikms_host" {
  max_age    = "24h"
  forward_to = [loki.relabel.rikms_units.receiver]
  labels = {
    application = "rikms",
    environment = sys.env("RIKMS_MONITORING_ENVIRONMENT"),
    host        = sys.env("RIKMS_MONITORING_HOST"),
  }
}

loki.relabel "rikms_units" {
  forward_to = [loki.write.grafana_cloud.receiver]

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(rikms-.*|nginx.service|php8.4-fpm.service|clamav-daemon.service|clamav-freshclam.service|mysql.service)"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOKI_TOKEN")
    }
  }
}
