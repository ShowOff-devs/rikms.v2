[Unit]
Description=Run the RIKMS Laravel scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/rikms
EnvironmentFile=-/etc/rikms/rikms.env
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/rikms/storage /var/www/rikms/bootstrap/cache
