# Copy to the deployment secret manager or /etc/rikms/rikms.env.
# Do not commit populated values. This file is an operator contract, not a runnable environment.

# Relational database: externally managed MySQL or MariaDB with TLS and backups.
DB_CONNECTION=mysql
DB_HOST=database.internal
DB_PORT=3306
DB_DATABASE=rikms
DB_USERNAME=replace-via-secret-manager
DB_PASSWORD=replace-via-secret-manager
MYSQL_ATTR_SSL_CA=/etc/rikms/ca/mysql-ca.pem

# MongoDB: required when production AI/PDF metadata processing is enabled.
INFRA_REQUIRE_MONGODB=true
MONGODB_URI=replace-via-secret-manager
MONGODB_DATABASE=rikms_ai

# Redis: shared queue/cache backend. Keep failed-job records in the relational database.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=predis
REDIS_URL=replace-via-secret-manager
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5

# Private S3-compatible object storage. Buckets or roots must be different.
INFRA_REQUIRE_REMOTE_STORAGE=true
UPLOAD_STORAGE_DISK=private_uploads_s3
UPLOAD_QUARANTINE_DISK=upload_quarantine_s3
AWS_ACCESS_KEY_ID=replace-via-secret-manager
AWS_SECRET_ACCESS_KEY=replace-via-secret-manager
AWS_DEFAULT_REGION=replace-with-region
AWS_PRIVATE_BUCKET=replace-with-private-bucket
AWS_PRIVATE_ROOT=private
AWS_QUARANTINE_BUCKET=replace-with-quarantine-bucket
AWS_QUARANTINE_ROOT=quarantine
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SERVER_SIDE_ENCRYPTION=AES256
# When populated, set AWS_SERVER_SIDE_ENCRYPTION=aws:kms.
AWS_KMS_KEY_ID=

# Readiness probes use temporary keys below this private prefix and clean them up.
INFRA_HEALTHCHECK_PREFIX=.rikms-health

# Required release gate for the externally operated backup destination.
# The deployment check performs a temporary write/read/delete probe but does not replace a restore drill.
INFRA_REQUIRE_BACKUP_READY=true
BACKUP_DESTINATION_PATH=/mnt/rikms-backup
BACKUP_ENCRYPTION_KEY=replace-via-secret-manager-with-at-least-32-bytes
BACKUP_MINIMUM_FREE_SPACE_MB=10240
BACKUP_REQUIRE_SEPARATE_FILESYSTEM=true
